#!/bin/bash
#SBATCH --job-name=pfam_dens
#SBATCH --output=logs/dark_proteome/density_%A_%a.out
#SBATCH --error=logs/dark_proteome/density_%A_%a.err
#SBATCH --array=1-PLACEHOLDER%200
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=00:30:00
#SBATCH --partition=compute

# =============================================================================
# Per-sample Pfam annotation density and dark proteome statistics
# =============================================================================
#
# Provenance:
#   Script: scripts/dark_proteome/02_pfam_density.sbatch
#   Generated: 2026-03-01
#   Target HPC: Jubail (NYU Abu Dhabi)
#
# Purpose:
#   For each sample, compute comprehensive Pfam annotation statistics:
#     1. Total predicted proteins (from FASTA)
#     2. Total amino acids (from FASTA)
#     3. Unique annotated proteins (from hmmsearch .tbl, E<1e-9)
#     4. Dark proteins (total - annotated)
#     5. Total domain hits (all non-comment .tbl rows)
#     6. Unique Pfam-A families detected
#     7. Derived metrics: pct_dark, pfam_per_orf, pfam_per_1000aa
#
#   Outputs one TSV row per sample, later aggregated by dataset.
#
# Input:
#   - algae_proteins/{stem}.aa.algae.fa   (protein FASTA)
#   - hmmsearch_results/{stem}.aa.hmmsearch.tbl  (hmmsearch tblout)
#   - dark_proteome/sample_list.txt  (generated by 00_audit.sh)
#
# Output:
#   - dark_proteome/pfam_density/{sample}.pfam_density.tsv
#
# Usage:
#   cd /scratch/drn2/PROJECTS/TARA-LA4SR
#   bash MANUSCRIPT/scripts/dark_proteome/submit_density.sh
#
# =============================================================================

set -euo pipefail

# ---- HPC environment ----
export HOME=/scratch/drn2/newhome
export TMPDIR=/scratch/drn2/tmp
mkdir -p "$TMPDIR"

unset NETWORKX_BACKEND_CONFIG 2>/dev/null || true
unset NX_BACKEND_CONFIG 2>/dev/null || true

# ---- Paths ----
BASE="/scratch/drn2/PROJECTS/TARA-LA4SR"
FASTA_DIR="${BASE}/03_analyses/algae_proteins"
HMMSEARCH_DIR="${BASE}/03_analyses/hmmsearch_results"
OUT_DIR="${BASE}/03_analyses/dark_proteome"
DENSITY_DIR="${OUT_DIR}/pfam_density"
SAMPLE_LIST="${OUT_DIR}/sample_list.txt"

mkdir -p "${DENSITY_DIR}"

# ---- Resolve sample ----
SAMPLE=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "${SAMPLE_LIST}")

if [[ -z "${SAMPLE}" ]]; then
    echo "ERROR: No sample at line ${SLURM_ARRAY_TASK_ID}"
    exit 1
fi

echo "========================================"
echo "Pfam Density Statistics"
echo "========================================"
echo "Sample:  ${SAMPLE}"
echo "Date:    $(date)"
echo ""

# ---- Locate FASTA ----
FASTA=""
for ext in ".aa.algae.fa" ".aa.algal.fa" ".fa" ".faa"; do
    if [[ -f "${FASTA_DIR}/${SAMPLE}${ext}" ]]; then
        FASTA="${FASTA_DIR}/${SAMPLE}${ext}"
        break
    fi
done

if [[ -z "${FASTA}" ]]; then
    echo "ERROR: FASTA not found for ${SAMPLE} in ${FASTA_DIR}"
    exit 1
fi

# ---- Locate hmmsearch .tbl ----
TBL=""
for ext in ".aa.hmmsearch.tbl" ".hmmsearch.tbl" ".tbl"; do
    if [[ -f "${HMMSEARCH_DIR}/${SAMPLE}${ext}" ]]; then
        TBL="${HMMSEARCH_DIR}/${SAMPLE}${ext}"
        break
    fi
done

echo "FASTA: ${FASTA}"
echo "TBL:   ${TBL:-NONE}"
echo ""

# ---- Compute FASTA statistics (total proteins + total amino acids) ----
echo "Computing FASTA stats..."
read N_PROTEINS TOTAL_AA < <(
    awk '
    /^>/ { n_proteins++ ; next }
    { total_aa += length($0) }
    END { print n_proteins+0, total_aa+0 }
    ' "${FASTA}"
)
echo "  Total proteins:    ${N_PROTEINS}"
echo "  Total amino acids: ${TOTAL_AA}"

# ---- Compute hmmsearch statistics ----
if [[ -n "${TBL}" && -f "${TBL}" ]]; then
    echo "Computing hmmsearch stats..."

    # One-pass awk: count total hits, unique protein IDs, unique Pfam names
    read N_DOMAIN_HITS N_ANNOTATED N_UNIQUE_PFAM < <(
        awk '
        /^#/ { next }
        {
            n_hits++
            proteins[$1] = 1
            # In tblout, column 3 is query name (Pfam profile name)
            pfams[$3] = 1
        }
        END {
            n_prot = 0; for (p in proteins) n_prot++
            n_pfam = 0; for (f in pfams) n_pfam++
            print n_hits+0, n_prot+0, n_pfam+0
        }
        ' "${TBL}"
    )
else
    N_DOMAIN_HITS=0
    N_ANNOTATED=0
    N_UNIQUE_PFAM=0
fi

N_DARK=$((N_PROTEINS - N_ANNOTATED))

# Handle edge case: more annotated than total (IDs in .tbl not in FASTA)
if [[ ${N_DARK} -lt 0 ]]; then
    echo "  WARNING: ${N_ANNOTATED} annotated > ${N_PROTEINS} total (extra IDs in .tbl)"
    N_DARK=0
fi

# ---- Derived metrics ----
if [[ ${N_PROTEINS} -gt 0 ]]; then
    PCT_DARK=$(awk "BEGIN {printf \"%.4f\", 100.0 * ${N_DARK} / ${N_PROTEINS}}")
    PFAM_PER_ORF=$(awk "BEGIN {printf \"%.4f\", ${N_DOMAIN_HITS} * 1.0 / ${N_PROTEINS}}")
else
    PCT_DARK="0.0000"
    PFAM_PER_ORF="0.0000"
fi

if [[ ${TOTAL_AA} -gt 0 ]]; then
    PFAM_PER_1000AA=$(awk "BEGIN {printf \"%.4f\", ${N_DOMAIN_HITS} * 1000.0 / ${TOTAL_AA}}")
else
    PFAM_PER_1000AA="0.0000"
fi

# ---- Report ----
echo ""
echo "Results:"
echo "  Annotated proteins:   ${N_ANNOTATED}"
echo "  Dark proteins:        ${N_DARK} (${PCT_DARK}%)"
echo "  Total domain hits:    ${N_DOMAIN_HITS}"
echo "  Unique Pfam families: ${N_UNIQUE_PFAM}"
echo "  Pfam per ORF:         ${PFAM_PER_ORF}"
echo "  Pfam per 1000 aa:     ${PFAM_PER_1000AA}"

# ---- Write output TSV ----
OUTFILE="${DENSITY_DIR}/${SAMPLE}.pfam_density.tsv"
cat > "${OUTFILE}" <<EOF
sample	n_proteins	total_aa	n_annotated	n_dark	n_domain_hits	n_unique_pfam	pct_dark	pfam_per_orf	pfam_per_1000aa
${SAMPLE}	${N_PROTEINS}	${TOTAL_AA}	${N_ANNOTATED}	${N_DARK}	${N_DOMAIN_HITS}	${N_UNIQUE_PFAM}	${PCT_DARK}	${PFAM_PER_ORF}	${PFAM_PER_1000AA}
EOF

echo ""
echo "Output: ${OUTFILE}"
echo "Done:   $(date)"
